<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@color/veyron_bg">
    <LinearLayout
        android:id="@+id/navigation" android:layout_width="174dp"
        android:layout_height="match_parent" android:orientation="vertical"
        android:padding="12dp" android:background="@color/veyron_surface">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="VEYRON" android:textColor="@color/veyron_accent"
            android:textStyle="bold" android:textSize="21sp" android:letterSpacing="0.16"
            android:padding="12dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="JAVA EDITION" android:textColor="@color/veyron_muted"
            android:textSize="10sp" android:paddingStart="12dp" android:paddingBottom="18dp"/>
        <LinearLayout android:id="@+id/navItems" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ANDROID • EARLY ACCESS" android:textColor="@color/veyron_muted"
            android:textSize="9sp" android:padding="10dp"/>
    </LinearLayout>
    <ScrollView android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/screenContent" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:padding="22dp"/>
    </ScrollView>
</LinearLayout>