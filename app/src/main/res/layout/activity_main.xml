<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/veyron_bg"
    android:fitsSystemWindows="false">

    <LinearLayout
        android:id="@+id/navigation"
        android:layout_width="168dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:background="@color/veyron_surface">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VEYRON"
            android:textColor="@color/veyron_accent"
            android:textStyle="bold"
            android:textSize="22sp"
            android:letterSpacing="0.13"
            android:paddingStart="12dp"
            android:paddingTop="9dp"
            android:paddingBottom="2dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MINECRAFT JAVA"
            android:textColor="@color/veyron_muted"
            android:textSize="9sp"
            android:letterSpacing="0.12"
            android:paddingStart="13dp"
            android:paddingBottom="16dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="12dp"
            android:background="#263844"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/navItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            android:background="#263844"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ANDROID  •  EARLY ACCESS"
            android:textColor="@color/veyron_muted"
            android:textSize="8sp"
            android:letterSpacing="0.06"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"/>
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#1E2A34"/>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:fadeScrollbars="true">

        <LinearLayout
            android:id="@+id/screenContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="22dp"
            android:paddingEnd="26dp"
            android:paddingBottom="26dp"/>
    </ScrollView>
</LinearLayout>