<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/veyron_bg</item>
        <item name="android:navigationBarColor">@color/veyron_bg</item>
        <item name="android:windowBackground">@color/veyron_bg</item>
        <item name="android:colorBackground">@color/veyron_bg</item>
        <item name="android:textColorPrimary">@color/veyron_text</item>
        <item name="android:textColorSecondary">@color/veyron_muted</item>
        <item name="android:colorAccent">@color/veyron_accent</item>
    </style>
</resources>